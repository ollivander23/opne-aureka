# ===========================================
# Aureka Environment Configuration
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# Metadata Database (SQLite)
DATABASE_URL=sqlite:./data/metadata.db

# Cache (Keyv + SQLite or memory)
CACHE_STORE=memory
CACHE_URL=sqlite:./data/cache.db

# File Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# DuckDB
DUCKDB_DATABASE=./data/analysis.duckdb

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# JitWord (source of truth for user credentials / SSO)
JITWORD_BASE_URL=https://next.jitword.com

# LLM Provider (openai | deepseek | qwen | kimi)
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
