{
  "name": "aureka",
  "version": "0.1.0",
  "private": true,
  "description": "Aureka - Intelligent Data Query & Analysis Platform",
  "scripts": {
    "start": "bash dev.sh",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@aureka/web",
    "dev:server": "turbo run dev --filter=@aureka/server",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@aureka/web",
    "build:server": "turbo run build --filter=@aureka/server",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
